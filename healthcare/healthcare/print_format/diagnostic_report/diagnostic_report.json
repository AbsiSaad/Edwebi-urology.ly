  "doc_type": "Diagnostic Report",
  "docstatus": 0,
  "doctype": "Print Format",
  "font_size": 14,
  "html": "<!DOCTYPE html>\r\n<html dir=\"rtl\" lang=\"ar\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n\r\n    <!-- Cairo Font -->\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&display=swap\" rel=\"stylesheet\">\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #1A7A4D;\r\n            --border: #dddddd;\r\n            --text-main: #222222;\r\n            --text-muted: #666666;\r\n            --bg-light: #f7f7f7;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: \"Cairo\", sans-serif;\r\n            background: #eeeeee;\r\n            padding: 10px;\r\n            color: var(--text-main);\r\n        }\r\nbody, * {\r\n    font-family: \"Cairo\", sans-serif !important;\r\n}\r\n\r\n        .invoice-container {\r\n            background: #ffffff;\r\n            max-width: 210mm;   /* A5 landscape width */\r\n            min-height: 148mm;  /* A5 landscape height */\r\n            margin: 0 auto;\r\n            border-radius: 6px;\r\n            border: 1px solid var(--border);\r\n            overflow: hidden;\r\n        }\r\n\r\n        /* HEADER (simple, no heavy colors) */\r\n        .header {\r\n            padding: 10px 18px;\r\n            border-bottom: 1px solid var(--border);\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n        }\r\n\r\n        .clinic-info {\r\n            line-height: 1.5;\r\n        }\r\n\r\n        .clinic-name-ar {\r\n            font-size: 18px;\r\n            font-weight: 800;\r\n            color: var(--primary);\r\n        }\r\n\r\n        .clinic-name-en {\r\n            font-size: 12px;\r\n            font-weight: 600;\r\n            color: var(--text-muted);\r\n        }\r\n\r\n        .clinic-extra {\r\n            font-size: 11px;\r\n            color: var(--text-muted);\r\n        }\r\n\r\n        .logo-circle {\r\n            width: 60px;\r\n            height: 60px;\r\n            border-radius: 50%;\r\n            border: 1px solid var(--border);\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .logo-circle img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: contain;\r\n        }\r\n\r\n        /* INVOICE TITLE */\r\n        .invoice-title-bar {\r\n            padding: 6px 18px;\r\n            border-bottom: 1px solid var(--border);\r\n            text-align: center;\r\n        }\r\n\r\n        .invoice-title {\r\n            font-size: 15px;\r\n            font-weight: 700;\r\n            color: var(--primary);\r\n        }\r\n\r\n        /* DETAILS (two small cards) */\r\n        .details-section {\r\n            display: grid;\r\n            grid-template-columns: 1.2fr 1.2fr;\r\n            gap: 10px;\r\n            padding: 10px 18px;\r\n            background: var(--bg-light);\r\n        }\r\n\r\n        .details-card {\r\n            background: #ffffff;\r\n            border: 1px solid var(--border);\r\n            border-radius: 4px;\r\n            padding: 8px 10px;\r\n            font-size: 11px;\r\n        }\r\n\r\n        .details-card-title {\r\n            font-size: 12px;\r\n            font-weight: 700;\r\n            color: var(--primary);\r\n            margin-bottom: 6px;\r\n            border-bottom: 1px solid var(--border);\r\n            padding-bottom: 3px;\r\n        }\r\n\r\n        .detail-row {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            padding: 3px 0;\r\n        }\r\n\r\n        .detail-label {\r\n            font-weight: 600;\r\n            color: var(--text-muted);\r\n        }\r\n\r\n        .detail-value {\r\n            font-weight: 700;\r\n            color: var(--text-main);\r\n        }\r\n\r\n        /* ITEMS TABLE – compact for A5 */\r\n        .services-section {\r\n            padding: 10px 18px 6px 18px;\r\n        }\r\n\r\n        .section-header {\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n            color: var(--primary);\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 11px;\r\n            border: 1px solid var(--border);\r\n        }\r\n\r\n        thead {\r\n            background: #f0f0f0;\r\n        }\r\n\r\n        thead th {\r\n            padding: 5px;\r\n            border-bottom: 1px solid var(--border);\r\n            border-left: 1px solid var(--border);\r\n            text-align: center;\r\n            font-weight: 700;\r\n            color: var(--text-main);\r\n        }\r\n\r\n        tbody td {\r\n            padding: 4px 5px;\r\n            border-bottom: 1px solid #e5e5e5;\r\n            border-left: 1px solid #e5e5e5;\r\n            text-align: center;\r\n        }\r\n\r\n        tbody tr:nth-child(even) {\r\n            background: #fafafa;\r\n        }\r\n\r\n        tbody td:first-child {\r\n            text-align: right;\r\n        }\r\n\r\n        /* TOTALS */\r\n        .totals {\r\n            padding: 6px 18px 8px 18px;\r\n        }\r\n\r\n        .totals-box {\r\n            width: 220px;\r\n            margin-left: auto;\r\n            border: 1px solid var(--border);\r\n            border-radius: 4px;\r\n            font-size: 11px;\r\n        }\r\n\r\n        .total-row {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            padding: 4px 8px;\r\n            border-bottom: 1px solid #e5e5e5;\r\n        }\r\n\r\n        .total-row:last-child {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .grand-total-row {\r\n            background: #f3f3f3;\r\n            font-weight: 800;\r\n        }\r\n\r\n        /* FOOTER */\r\n        .footer {\r\n            border-top: 1px solid var(--border);\r\n            padding: 6px 18px;\r\n            font-size: 10px;\r\n            color: var(--text-muted);\r\n            text-align: center;\r\n        }\r\n\r\n        @media print {\r\n            body {\r\n                background: #ffffff;\r\n                padding: 0;\r\n            }\r\n            .invoice-container {\r\n                border-radius: 0;\r\n                border: none;\r\n                max-width: 100%;\r\n                min-height: auto;\r\n            }\r\n            @page {\r\n                size: A5 landscape;\r\n                margin: 5mm;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n<div class=\"invoice-container\">\r\n\r\n    <!-- HEADER -->\r\n    <div class=\"header\">\r\n        <div class=\"clinic-info\">\r\n            <div class=\"clinic-name-ar\">عيادة الحسناء</div>\r\n            <div class=\"clinic-name-en\">Al-Hasna Clinic</div>\r\n            <div class=\"clinic-extra\">خدمات طبية وتشخيصية</div>\r\n        </div>\r\n\r\n        <div class=\"logo-circle\">\r\n            <img src=\"/files/96f64f43-169a-468d-a10f-8d8fca249189.png\">\r\n        </div>\r\n    </div>\r\n\r\n    <!-- INVOICE TITLE -->\r\n    <div class=\"invoice-title-bar\">\r\n        <div class=\"invoice-title\">فاتورة علاج / MEDICAL INVOICE</div>\r\n    </div>\r\n\r\n    <!-- DETAILS SECTION -->\r\n    <div class=\"details-section\">\r\n\r\n        <!-- Invoice Details -->\r\n        <div class=\"details-card\">\r\n            <div class=\"details-card-title\">بيانات الفاتورة</div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">رقم الفاتورة:</span>\r\n                <span class=\"detail-value\">{{ doc.name }}</span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">التاريخ:</span>\r\n                <span class=\"detail-value\">{{ doc.posting_date }}</span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">الوقت:</span>\r\n                <span class=\"detail-value\">{{ doc.posting_time }}</span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">الموظف:</span>\r\n                <span class=\"detail-value\">{{ doc.owner }}</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Patient Details -->\r\n        <div class=\"details-card\">\r\n            <div class=\"details-card-title\">بيانات المريض</div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">الاسم:</span>\r\n                <span class=\"detail-value\">{{ doc.patient_name or doc.patient }}</span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">الرقم الوطني:</span>\r\n                <span class=\"detail-value\">{{ doc.patient_national_id or \"-\" }}</span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">الهاتف:</span>\r\n                <span class=\"detail-value\">{{ doc.patient_phone or \"-\" }}</span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">العمر:</span>\r\n                <span class=\"detail-value\">\r\n                    {% if doc.patient_birth_date %}\r\n                        {{ frappe.utils.getdate().year - frappe.utils.getdate(doc.patient_birth_date).year }} سنة\r\n                    {% else %}-{% endif %}\r\n                </span>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- SERVICES TABLE -->\r\n    <div class=\"services-section\">\r\n        <div class=\"section-header\">الخدمات الطبية</div>\r\n\r\n        <table>\r\n            <thead>\r\n            <tr>\r\n                <th style=\"width: 6%;\">م</th>\r\n                <th style=\"width: 44%;\">الخدمة / الإجراء</th>\r\n                <th style=\"width: 10%;\">الكمية</th>\r\n                <th style=\"width: 20%;\">سعر الوحدة</th>\r\n                <th style=\"width: 20%;\">الإجمالي</th>\r\n            </tr>\r\n            </thead>\r\n            <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td style=\"text-align:right;\">{{ item.item_name }}</td>\r\n                <td>{{ item.qty }}</td>\r\n                <td>{{ item.rate }} د.ل</td>\r\n                <td>{{ item.amount }} د.ل</td>\r\n            </tr>\r\n            {% endfor %}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- TOTALS -->\r\n    <div class=\"totals\">\r\n        <div class=\"totals-box\">\r\n            <div class=\"total-row\">\r\n                <span>إجمالي الخدمات:</span>\r\n                <span>{{ doc.total }} د.ل</span>\r\n            </div>\r\n            <div class=\"total-row\">\r\n                <span>الخصم:</span>\r\n                <span>{{ doc.discount_amount or 0 }} د.ل</span>\r\n            </div>\r\n            {% if doc.total_taxes_and_charges %}\r\n            <div class=\"total-row\">\r\n                <span>الضريبة:</span>\r\n                <span>{{ doc.total_taxes_and_charges }} د.ل</span>\r\n            </div>\r\n            {% endif %}\r\n            <div class=\"total-row grand-total-row\">\r\n                <span>المبلغ المستحق:</span>\r\n                <span>{{ doc.grand_total }} د.ل</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- FOOTER -->\r\n    <div class=\"footer\">\r\n        شكراً لاختياركم عيادة الحسناء  \r\n        – هذه الفاتورة صالحة للاستخدام داخل السجلات الطبية والمالية للعيادة –\r\n    </div>\r\n\r\n</div>\r\n</body>\r\n</html>\r\n",
