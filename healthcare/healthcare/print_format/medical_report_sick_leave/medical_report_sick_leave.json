{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-01-27 10:00:00",
 "custom_format": 1,
 "default_print_language": "ar",
 "disabled": 0,
 "doc_type": "Medical Report",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "font_size": 0,
 "html": "<!DOCTYPE html>\r\n<html dir=\"rtl\" lang=\"ar\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&display=swap\" rel=\"stylesheet\">\r\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css\">\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #4CAF50;\r\n            --primary-light: #E8F5E9;\r\n            --accent: #81C784;\r\n            --border: #E0E0E0;\r\n            --text-main: #212121;\r\n            --text-muted: #757575;\r\n            --bg-light: #FAFAFA;\r\n            --white: #FFFFFF;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: \"Cairo\", sans-serif;\r\n            background: var(--bg-light);\r\n            padding: 0;\r\n            margin: 0;\r\n            color: var(--text-main);\r\n        }\r\n\r\n        body, * {\r\n            font-family: \"Cairo\", sans-serif !important;\r\n        }\r\n\r\n        .certificate-container {\r\n            background: var(--white);\r\n            width: 210mm;\r\n            min-height: 297mm;\r\n            margin: 0 auto;\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n\r\n        /* Top Bar */\r\n        .top-bar {\r\n            background: var(--white);\r\n            padding: 20px 30px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            border-bottom: 2px solid var(--primary);\r\n        }\r\n\r\n        .clinic-section {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 20px;\r\n        }\r\n\r\n        .logo-circle {\r\n            width: 60px;\r\n            height: 60px;\r\n            border-radius: 50%;\r\n            background: var(--primary-light);\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            overflow: hidden;\r\n            border: 2px solid var(--primary);\r\n        }\r\n\r\n        .logo-circle img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: contain;\r\n        }\r\n\r\n        .clinic-text {\r\n            color: var(--text-main);\r\n            line-height: 1.4;\r\n        }\r\n\r\n        .clinic-text h1 {\r\n            font-size: 24px;\r\n            font-weight: 700;\r\n            margin-bottom: 4px;\r\n            color: var(--primary);\r\n        }\r\n\r\n        .clinic-text p {\r\n            font-size: 12px;\r\n            color: var(--text-muted);\r\n        }\r\n\r\n        .certificate-badge {\r\n            background: var(--primary);\r\n            color: var(--white);\r\n            padding: 10px 20px;\r\n            border-radius: 4px;\r\n            display: flex;\r\n            flex-direction: column;\r\n            align-items: center;\r\n            gap: 2px;\r\n            line-height: 1.3;\r\n        }\r\n\r\n        .certificate-badge-ar {\r\n            font-size: 18px;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .certificate-badge-en {\r\n            font-size: 10px;\r\n            font-weight: 500;\r\n            opacity: 0.9;\r\n        }\r\n\r\n        /* Main Content */\r\n        .content-wrapper {\r\n            padding: 20px 30px;\r\n            flex: 1;\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 20px;\r\n        }\r\n\r\n        /* Patient Information Card */\r\n        .patient-info-card {\r\n            background: var(--primary-light);\r\n            border: 1px solid var(--primary);\r\n            border-radius: 8px;\r\n            padding: 20px;\r\n        }\r\n\r\n        .patient-header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        .patient-title {\r\n            font-size: 18px;\r\n            font-weight: 700;\r\n            color: var(--primary);\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n        }\r\n\r\n        .patient-icon {\r\n            width: 30px;\r\n            height: 30px;\r\n            background: var(--primary);\r\n            color: var(--white);\r\n            border-radius: 4px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            font-size: 14px;\r\n        }\r\n\r\n        .report-date {\r\n            background: var(--white);\r\n            padding: 6px 12px;\r\n            border-radius: 4px;\r\n            font-size: 11px;\r\n            font-weight: 600;\r\n            color: var(--text-muted);\r\n            border: 1px solid var(--border);\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 6px;\r\n        }\r\n\r\n        .report-date i {\r\n            color: var(--primary);\r\n        }\r\n\r\n        .patient-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\r\n            gap: 12px;\r\n        }\r\n\r\n        .patient-item {\r\n            background: var(--white);\r\n            padding: 10px 14px;\r\n            border-radius: 4px;\r\n            border: 1px solid var(--border);\r\n        }\r\n\r\n        .patient-label {\r\n            font-size: 10px;\r\n            color: var(--text-muted);\r\n            margin-bottom: 3px;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .patient-value {\r\n            font-size: 13px;\r\n            font-weight: 600;\r\n            color: var(--text-main);\r\n        }\r\n\r\n        /* Content Grid */\r\n        .content-grid {\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            gap: 20px;\r\n            flex: 1;\r\n        }\r\n\r\n        /* Diagnosis Box */\r\n        .diagnosis-box {\r\n            background: var(--white);\r\n            border: 1px solid var(--border);\r\n            border-radius: 8px;\r\n            padding: 18px;\r\n        }\r\n\r\n        .diagnosis-title {\r\n            font-size: 15px;\r\n            font-weight: 700;\r\n            color: var(--primary);\r\n            margin-bottom: 12px;\r\n            padding-bottom: 8px;\r\n            border-bottom: 2px solid var(--primary);\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n        }\r\n\r\n        .diagnosis-icon {\r\n            width: 22px;\r\n            height: 22px;\r\n            background: var(--primary);\r\n            color: var(--white);\r\n            border-radius: 4px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            font-size: 12px;\r\n        }\r\n\r\n        .diagnosis-content {\r\n            line-height: 1.6;\r\n            font-size: 13px;\r\n            color: var(--text-main);\r\n        }\r\n\r\n        /* Sick Leave Card */\r\n        .sick-leave-card {\r\n            background: var(--white);\r\n            border: 1px solid var(--border);\r\n            border-radius: 8px;\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n\r\n        .sick-leave-header {\r\n            background: var(--primary);\r\n            color: var(--white);\r\n            font-size: 15px;\r\n            font-weight: 700;\r\n            padding: 10px 18px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            gap: 8px;\r\n        }\r\n\r\n        .sick-leave-icon {\r\n            width: 20px;\r\n            height: 20px;\r\n            background: rgba(255,255,255,0.2);\r\n            border-radius: 4px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            font-size: 12px;\r\n        }\r\n\r\n        .sick-leave-body {\r\n            padding: 18px;\r\n            flex: 1;\r\n            display: flex;\r\n            flex-direction: column;\r\n            justify-content: center;\r\n        }\r\n\r\n        .sick-leave-content {\r\n            font-size: 13px;\r\n            line-height: 1.8;\r\n            color: var(--text-main);\r\n            text-align: center;\r\n        }\r\n\r\n        .sick-leave-content strong {\r\n            font-size: 15px;\r\n            color: var(--primary);\r\n            font-weight: 700;\r\n        }\r\n\r\n        .date-highlight {\r\n            background: var(--primary-light);\r\n            padding: 8px 12px;\r\n            border-radius: 4px;\r\n            margin: 5px 0;\r\n            border: 1px solid var(--primary);\r\n            display: inline-block;\r\n        }\r\n\r\n        /* Signature Section */\r\n        .signature-section {\r\n            margin-top: 20px;\r\n            padding: 20px 30px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: flex-end;\r\n            border-top: 1px solid var(--border);\r\n            background: var(--bg-light);\r\n        }\r\n\r\n        .signature-box {\r\n            text-align: center;\r\n            width: 200px;\r\n        }\r\n\r\n        .signature-image {\r\n            min-height: 70px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .signature-image img {\r\n            max-width: 140px;\r\n            max-height: 70px;\r\n        }\r\n\r\n        .signature-line {\r\n            border-top: 2px solid var(--primary);\r\n            margin-top: 8px;\r\n            padding-top: 8px;\r\n        }\r\n\r\n        .signature-line strong {\r\n            display: block;\r\n            margin-bottom: 4px;\r\n            color: var(--primary);\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .signature-line div {\r\n            font-size: 10px;\r\n            color: var(--text-muted);\r\n        }\r\n\r\n        /* Footer */\r\n        .footer {\r\n            background: var(--primary);\r\n            color: var(--white);\r\n            text-align: center;\r\n            padding: 12px 30px;\r\n            font-size: 10px;\r\n            margin-top: auto;\r\n        }\r\n\r\n        .footer strong {\r\n            font-weight: 700;\r\n        }\r\n\r\n        /* Print Styles */\r\n        @media print {\r\n            @page {\r\n                size: A4;\r\n                margin: 10mm;\r\n            }\r\n            body {\r\n                -webkit-print-color-adjust: exact;\r\n                print-color-adjust: exact;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n<div class=\"certificate-container\">\r\n\r\n    <!-- TOP BAR -->\r\n    <div class=\"top-bar\">\r\n        <div class=\"clinic-section\">\r\n            <div class=\"logo-circle\">\r\n                <img src=\"https://www.edwebi-urology.ly/files/96f64f43-169a-468d-a10f-8d8fca249189.png\" alt=\"Logo\">\r\n            </div>\r\n            <div class=\"clinic-text\">\r\n                <h1>\u0639\u064a\u0627\u062f\u0629 \u0627\u0644\u062f\u0648\u064a\u0628\u064a \u0644\u062c\u0631\u0627\u062d\u0629 \u0627\u0644\u0645\u0633\u0627\u0644\u0643 \u0627\u0644\u0628\u0648\u0644\u064a\u0629</h1>\r\n                <p>Edwebi Urology Clinic \u2022 \u062e\u062f\u0645\u0627\u062a \u0637\u0628\u064a\u0629 \u0645\u062a\u0645\u064a\u0632\u0629</p>\r\n            </div>\r\n        </div>\r\n        <div class=\"certificate-badge\">\r\n            <span class=\"certificate-badge-ar\">\u0634\u0647\u0627\u062f\u0629 \u0625\u062c\u0627\u0632\u0629 \u0645\u0631\u0636\u064a\u0629</span>\r\n            <span class=\"certificate-badge-en\">Medical Sick Leave Certificate</span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- MAIN CONTENT -->\r\n    <div class=\"content-wrapper\">\r\n        \r\n        <!-- Patient Information Card -->\r\n        <div class=\"patient-info-card\">\r\n            <div class=\"patient-header\">\r\n                <div class=\"patient-title\">\r\n                    <div class=\"patient-icon\">\r\n                        <i class=\"bi bi-person-fill\"></i>\r\n                    </div>\r\n                    \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u064a\u0636\r\n                </div>\r\n                <div class=\"report-date\">\r\n                    <i class=\"bi bi-calendar3\"></i>\r\n                    {{ doc.report_date }}\r\n                </div>\r\n            </div>\r\n            <div class=\"patient-grid\">\r\n                <div class=\"patient-item\">\r\n                    <div class=\"patient-label\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0631\u064a\u0636</div>\r\n                    <div class=\"patient-value\">{{ doc.patient_name or doc.patient }}</div>\r\n                </div> \r\n                <div class=\"patient-item\">\r\n                    <div class=\"patient-label\">\u0627\u0644\u0639\u0645\u0631</div>\r\n<div class=\"patient-value\">\r\n    {{ doc.age.split('years=+')[1].split(',')[0] }} \u0633\u0646\u0629\r\n</div>                </div>\r\n                <div class=\"patient-item\">\r\n                    <div class=\"patient-label\">\u0627\u0644\u062c\u0646\u0633</div>\r\n                    <div class=\"patient-value\">{{ doc.gender or \"-\" }}</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Content Grid -->\r\n        <div class=\"content-grid\">\r\n            \r\n            <!-- Diagnosis Box -->\r\n            {% if doc.diagnosis %}\r\n            <div class=\"diagnosis-box\">\r\n                <div class=\"diagnosis-title\">\r\n                    <div class=\"diagnosis-icon\">\r\n                        <i class=\"bi bi-clipboard2-pulse-fill\"></i>\r\n                    </div>\r\n                    Diagnosis / \u0627\u0644\u062a\u0634\u062e\u064a\u0635\r\n                </div>\r\n                <div class=\"diagnosis-content\">{{ doc.diagnosis }}</div>\r\n            </div>\r\n            {% endif %}\r\n\r\n            <!-- Sick Leave Card -->\r\n            <div class=\"sick-leave-card\">\r\n                <div class=\"sick-leave-header\">\r\n                    <div class=\"sick-leave-icon\">\r\n                        <i class=\"bi bi-house-heart-fill\"></i>\r\n                    </div>\r\n                    \u0641\u062a\u0631\u0629 \u0627\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0645\u0631\u0636\u064a\u0629\r\n                </div>\r\n                <div class=\"sick-leave-body\">\r\n                    {% if doc.sick_leave_from and doc.sick_leave_to %}\r\n                    <div class=\"sick-leave-content\">\r\n                        \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0641\u062d\u0635 \u0627\u0644\u0637\u0628\u064a\u060c \u064a\u064f\u0646\u0635\u062d \u0627\u0644\u0645\u0631\u064a\u0636 \u0628\u0623\u062e\u0630 \u0625\u062c\u0627\u0632\u0629 \u0645\u0631\u0636\u064a\u0629 \u0644\u0645\u062f\u0629:<br>\r\n                        <strong>{{ doc.duration or \"-\" }}</strong><br><br>\r\n                        <div class=\"date-highlight\">\r\n                            \u0645\u0646 \u062a\u0627\u0631\u064a\u062e: <strong>{{ doc.sick_leave_from }}</strong>\r\n                        </div>\r\n                        <div class=\"date-highlight\">\r\n                            \u0625\u0644\u0649 \u062a\u0627\u0631\u064a\u062e: <strong>{{ doc.sick_leave_to }}</strong>\r\n                        </div>\r\n                        {% if doc.return_to_work_date %}\r\n                            <br>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0648\u062f\u0629 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u0644\u0644\u0639\u0645\u0644: <strong>{{ doc.return_to_work_date }}</strong>\r\n                        {% endif %}\r\n                    </div>\r\n                    {% else %}\r\n                    <div class=\"sick-leave-content\">\r\n                        \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0641\u062d\u0635 \u0627\u0644\u0637\u0628\u064a\u060c \u064a\u064f\u0646\u0635\u062d \u0627\u0644\u0645\u0631\u064a\u0636 \u0628\u0623\u062e\u0630 \u0642\u0633\u0637 \u0645\u0646 \u0627\u0644\u0631\u0627\u062d\u0629 \u0627\u0644\u0637\u0628\u064a\u0629 \u062d\u0633\u0628 \u0627\u0644\u062d\u0627\u062c\u0629.\r\n                    </div>\r\n                    {% endif %}\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <!-- Signature Section -->\r\n        <div class=\"signature-section\">\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-image\">\r\n                    {% if doc.digital_signature %}\r\n                        <img src=\"{{ doc.digital_signature }}\" alt=\"Signature\">\r\n                    {% endif %}\r\n                </div>\r\n                <div class=\"signature-line\">\r\n                    <strong>{{ doc.doctor_name or doc.doctor }}</strong>\r\n                    {% if doc.license_number %}\r\n                        <div>License No: {{ doc.license_number }}</div>\r\n                    {% endif %}\r\n                    <div>Doctor Signature / \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0637\u0628\u064a\u0628</div>\r\n                </div>\r\n            </div>\r\n            {% if doc.official_stamp %}\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-image\">\r\n                    <img src=\"{{ doc.official_stamp }}\" alt=\"Official Stamp\">\r\n                </div>\r\n                <div style=\"margin-top: 8px; font-size: 10px; color: var(--text-muted);\">\r\n                    Official Stamp / \u0627\u0644\u062e\u062a\u0645 \u0627\u0644\u0631\u0633\u0645\u064a\r\n                </div>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- FOOTER -->\r\n    <div class=\"footer\">\r\n<strong>\u0639\u064a\u0627\u062f\u0629 \u0627\u0644\u062f\u0648\u064a\u0628\u064a \u0644\u062c\u0631\u0627\u062d\u0629 \u0627\u0644\u0645\u0633\u0627\u0644\u0643 \u0627\u0644\u0628\u0648\u0644\u064a\u0629</strong> \u2022 \u0647\u0630\u0627 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0635\u0627\u062f\u0631 \u0639\u0646 \u0639\u064a\u0627\u062f\u0629 \u0627\u0644\u062f\u0648\u064a\u0628\u064a \u0644\u062c\u0631\u0627\u062d\u0629 \u0627\u0644\u0645\u0633\u0627\u0644\u0643 \u0627\u0644\u0628\u0648\u0644\u064a\u0629 \u0648\u0647\u0648 \u0648\u062b\u064a\u0642\u0629 \u0637\u0628\u064a\u0629 \u0631\u0633\u0645\u064a\u0629 \u0635\u0627\u0644\u062d\u0629 \u0644\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0645\u0631\u0636\u064a\u0629 | This certificate is issued by Edwebi Urology Clinic and is an official medical document valid for sick leave\r\n    </div>\r\n\r\n</div>\r\n</body>\r\n</html>",
